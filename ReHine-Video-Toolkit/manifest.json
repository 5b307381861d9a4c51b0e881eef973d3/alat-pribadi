{
  "manifest_version": 3,
  "name": "ReHine Video Toolkit",
  "version": "1.0.0",
  "description": "ReHine video toolkit dengan pemrosesan MP4 lokal dan analisis metadata serta stream TikTok.",
  "permissions": [],
  "host_permissions": [
    "https://www.tiktok.com/*",
    "https://*.tiktokcdn.com/*",
    "https://*.tiktokv.com/*",
    "https://*.byteoversea.com/*",
    "https://*.ibytedtos.com/*",
    "https://*.muscdn.com/*",
    "https://*.tiktokcdn-us.com/*",
    "https://*.tiktok.com/*",
    "https://cutefish.my.id/*",
    "https://raw.githubusercontent.com/*"
  ],
  "action": {
    "default_title": "ReHine",
    "default_popup": "ui/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.tiktok.com/*"
      ],
      "js": [
        "engine/engine-core.js",
        "analyzer/cutefish-analyzer.js",
        "integration/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "engine/engine.html",
        "engine/engine-core.js",
        "engine/engine-ui.js",
        "engine/media-worker.js"
      ],
      "matches": [
        "https://www.tiktok.com/*"
      ]
    }
  ],
  "background": {
    "service_worker": "analyzer/api-worker.js"
  },
  "key": ""
}
