{
  "manifest_version": 3,
  "name": "RE:HINE Uploader",
  "key": "",
  "version": "1.0.127",
  "minimum_chrome_version": "111",
  "action": {
    "default_title": "RE:HINE Uploader",
    "default_popup": "ui/popup/popup.html"
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "clipboardRead",
    "clipboardWrite",
    "tabs",
    "scripting",
    "notifications"
  ],
  "host_permissions": [
    "https://*.tiktok.com/*",
    "https://cutefish.my.id/*",
    "https://raw.githubusercontent.com/*",
    "http://127.0.0.1/*",
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.tiktok.com/*",
        "*://*.tiktok.com/*"
      ],
      "js": [
        "content/main-world/desktop-mode.js",
        "content/main-world/caption-signature-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://www.tiktok.com/*",
        "*://*.tiktok.com/*"
      ],
      "js": [
        "content/main-world/publish-request-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.tiktok.com/*",
        "*://*.tiktok.com/*"
      ],
      "js": [
        "content/main-world/video-url-hook.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.tiktok.com/*",
        "*://*.tiktok.com/*"
      ],
      "js": [
        "content/isolated/status-badge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.tiktok.com/*",
        "*://*.tiktok.com/*"
      ],
      "js": [
        "core/theme-vars.js",
        "content/isolated/video-meta.js",
        "content/isolated/upload-card.js"
      ],
      "css": [
        "styles/upload-card.css"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "content/isolated/wa-status.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/bg.mp4"
      ],
      "matches": [
        "*://*.tiktok.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}